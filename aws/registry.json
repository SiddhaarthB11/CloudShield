{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudShield image registry for the disposable AWS lab",
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EmptyOnDelete": true,
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep the last 10 lab images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    }
  },
  "Outputs": {
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "RepositoryArn": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "Arn"
        ]
      }
    }
  }
}
